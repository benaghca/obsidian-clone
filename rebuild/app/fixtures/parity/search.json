{
  "about": "Which files a query matches in a small vault, with each note's match count and every shown line number. An attachment that matches maps to {}. null means the query has nothing to search for. Keys are a map: order is not part of the result.",
  "typescript": "searchVault in src/shell/searchVault.ts, over parseQuery, matches, shownLines and matchCount",
  "rust": "Index::search_notes + search_lines + passes (index/search.rs)",
  "vaults": {
    "obsidian-1.14.4": {
      "A.md": [
        "---",
        "status: done",
        "project: Grove",
        "tags: [gamma]",
        "---",
        "Alpha line here",
        "another line with beta",
        "star wars is a phrase",
        "wars star reversed",
        "#inline-tag"
      ],
      "B.md": [
        "---",
        "status: in progress",
        "category:",
        "  - one",
        "  - two",
        "---",
        "alpha beta on one line"
      ],
      "C.md": [
        "No frontmatter here. alpha only."
      ],
      "Props.md": [
        "---",
        "tags:",
        "  - alpha",
        "  - beta",
        "status: draft",
        "---",
        "Body text with five words."
      ],
      "Projects/Roadmap.md": [
        "---",
        "status: draft",
        "---",
        "The roadmap mentions alpha and gamma."
      ],
      "Gamma file.md": [
        "Nothing relevant inside."
      ],
      "Daily/2026-10-21.md": [
        "Daily note with beta."
      ]
    },
    "match-case": {
      "Other.md": [
        "---",
        "status: done",
        "---",
        "",
        "alpha beta alpha gamma",
        "Alpha again"
      ],
      "Props.md": [
        "---",
        "tags:",
        "  - alpha",
        "---",
        "",
        "Body text with Alpha and alpha and ALPHA."
      ],
      "Upper.md": [
        "Only ALPHA here"
      ]
    },
    "names": {
      "Upper.MD": [
        "Nothing about the extension."
      ],
      "Note.md": [
        "nope"
      ],
      "photo.png": "alpha sits in the file bytes",
      "Board.canvas": "{\"nodes\":[{\"text\":\"alpha\"}]}"
    },
    "tags": {
      "Nested.md": [
        "---",
        "tags:",
