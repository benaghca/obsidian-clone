    {
      "name": "MD does not match the extension of Upper.MD",
      "vault": "names",
      "input": "MD",
      "matchCase": true,
      "expected": {},
      "note": "Match case compares the stem. .md in any case is the extension, not part of the name, so MD does not match Upper.MD."
    },
    {
      "name": "file:md includes Upper.MD",
