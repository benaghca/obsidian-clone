          "lines": [
            6
          ]
        },
        "B.md": {
          "count": 1,
          "lines": [
            7
          ]
        },
        "C.md": {
          "count": 1,
          "lines": [
            1
          ]
        },
        "Projects/Roadmap.md": {
          "count": 1,
          "lines": [
