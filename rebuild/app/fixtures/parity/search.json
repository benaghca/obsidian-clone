        "done: true",
        "---",
        "body"
      ],
      "List.md": [
        "---",
        "category:",
        "  - one",
        "  - two",
        "---",
        "body"
      ],
      "Hash.md": [
        "---",
        "tags: \"#a\"",
        "---",
        "body"
      ],
      "Number.md": [
        "---",
