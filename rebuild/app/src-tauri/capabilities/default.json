{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window and a note's own windows (Open in new window), on the app's own origin only, can call the vault commands (and read and write their own settings in the vault's .grove folder), open or create a vault folder, open a note in a window of its own, listen for vault-changed, drive their own frameless window, set their own zoom level (Settings → Interface → Zoom level), and hand http, https and mailto links to the system opener.",
  "windows": [
    "main",
    "note-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-open-vault",
    "allow-create-vault",
    "allow-last-vault",
    "allow-list-files",
    "allow-read-note",
    "allow-read-file-bytes",
    "allow-write-note",
    "allow-write-file-bytes",
    "allow-create-note",
    "allow-create-folder",
    "allow-rename-path",
    "allow-delete-path",
    "allow-search",
    "allow-link-index",
    "allow-backlinks",
    "allow-frontmatter",
    "allow-tags",
    "allow-read-config",
    "allow-write-config",
    "allow-open-note-window",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
