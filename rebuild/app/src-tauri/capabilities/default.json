{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window, on the app's own origin only, can call the vault commands (and read and write its own settings in the vault's .grove folder), listen for vault-changed, drive its own frameless window, set its own zoom level (Settings → Interface → Zoom level), and hand http, https and mailto links to the system opener.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-open-vault",
    "allow-last-vault",
    "allow-list-files",
    "allow-read-note",
    "allow-write-note",
    "allow-create-note",
    "allow-create-folder",
    "allow-rename-path",
    "allow-delete-path",
    "allow-search",
    "allow-link-index",
    "allow-read-config",
    "allow-write-config",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
