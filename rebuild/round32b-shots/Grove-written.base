# Keep this comment
filters:
  not:
    - status == "waiting"
properties:
  file.name:
    displayName: Task
  note.due:
    displayName: Due date
views:
  - type: table
    name: "By due"
    filters:
      or:
        - file.hasTag("work")
        - priority > 1
    order:
      - file.name
      - status
      - due
      - priority
    sort:
      - property: due
        direction: ASC
      - property: file.name
        direction: DESC
    limit: 2
