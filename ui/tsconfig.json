{
  "//": "Type-checks Cinder's front end without a build step: `npm run typecheck` in ui/editor. The ui/app/*.js pieces are plain scripts that share one scope (src/api.rs joins them), which is how TypeScript reads files without imports.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "types/globals.d.ts",
    "themes.js",
    "yaml.js",
    "templater.js",
    "tasks.js",
    "bases.js",
    "diff.js",
    "related.js",
    "search.js",
    "properties.js",
    "images.js",
    "graph.js",
    "canvas.js",
    "draw-render.js",
    "draw.js",
    "app/core.js",
    "app/vault-index.js",
    "app/navigation.js",
    "app/drawings.js",
    "app/window.js",
    "app/tabs.js",
    "app/canvases.js",
    "app/bases.js",
    "app/tasks.js",
    "app/inbox.js",
    "app/markdown.js",
    "app/file-tree.js",
    "app/files.js",
    "app/templates.js",
    "app/template-help.js",
    "app/calendar.js",
    "app/history.js",
    "app/conflicts.js",
    "app/export.js",
    "app/related-notes.js",
    "app/split.js",
    "app/editor.js",
    "app/properties.js",
    "app/link-embeds.js",
    "app/images.js",
    "app/dialogs.js",
    "app/commands.js",
    "app/settings.js",
    "app/vaults.js",
    "app/appearance.js",
    "app/panels.js",
    "app/bookmarks.js",
    "app/graph.js",
    "app/actions.js",
    "app/native-ui.js",
    "app/boot.js"
  ]
}
